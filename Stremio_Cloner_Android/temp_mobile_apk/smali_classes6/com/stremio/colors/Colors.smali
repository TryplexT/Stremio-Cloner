00c3\u0007\u0010\u0006R\u001e\u0010\u00c4\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c5\u0007\u0010\u0006R\u001e\u0010\u00c6\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c7\u0007\u0010\u0006R\u001e\u0010\u00c8\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c9\u0007\u0010\u0006R\u001e\u0010\u00ca\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00cb\u0007\u0010\u0006R\u001e\u0010\u00cc\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00cd\u0007\u0010\u0006R\u001e\u0010\u00ce\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00cf\u0007\u0010\u0006R\u001e\u0010\u00d0\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d1\u0007\u0010\u0006R\u001e\u0010\u00d2\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d3\u0007\u0010\u0006R\u001e\u0010\u00d4\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d5\u0007\u0010\u0006R\u001e\u0010\u00d6\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d7\u0007\u0010\u0006R\u001e\u0010\u00d8\u0007\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d9\u0007\u0010\u0006R\u001e\u0010\u00da\