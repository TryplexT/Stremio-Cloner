00\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u008f\t\u0010\u0006R\u001e\u0010\u0090\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0091\t\u0010\u0006R\u001e\u0010\u0092\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0093\t\u0010\u0006R\u001e\u0010\u0094\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0095\t\u0010\u0006R\u001e\u0010\u0096\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0097\t\u0010\u0006R\u001e\u0010\u0098\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0099\t\u0010\u0006R\u001e\u0010\u009a\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u009b\t\u0010\u0006R\u001e\u0010\u009c\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u009d\t\u0010\u0006R\u001e\u0010\u009e\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u009f\t\u0010\u0006R\u001e\u0010\u00a0\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a1\t\u0010\u0006R\u001e\u0010\u00a2\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a3\t\u0010\u0006R\u001e\u0010\u00a4\t\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a5\t\u0010\u0006R\u001e\u0010\u0