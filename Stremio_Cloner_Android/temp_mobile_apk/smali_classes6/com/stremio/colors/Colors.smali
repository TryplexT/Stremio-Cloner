\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0091\u000b\u0010\u0006R\u001e\u0010\u0092\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0093\u000b\u0010\u0006R\u001e\u0010\u0094\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0095\u000b\u0010\u0006R\u001e\u0010\u0096\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0097\u000b\u0010\u0006R\u001e\u0010\u0098\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0099\u000b\u0010\u0006R\u001e\u0010\u009a\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u009b\u000b\u0010\u0006R\u001e\u0010\u009c\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u009d\u000b\u0010\u0006R\u001e\u0010\u009e\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u009f\u000b\u0010\u0006R\u001e\u0010\u00a0\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a1\u000b\u0010\u0006R\u001e\u0010\u00a2\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a3\u000b\u0010\u0006R\u001e\u0010\u00a4\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a5\u000b\u0010\u0006R\u001e\u0010\u00a6\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2