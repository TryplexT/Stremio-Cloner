05\u0008\u00bd\u000b\u0010\u0006R\u001e\u0010\u00be\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00bf\u000b\u0010\u0006R\u001e\u0010\u00c0\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c1\u000b\u0010\u0006R\u001e\u0010\u00c2\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c3\u000b\u0010\u0006R\u001e\u0010\u00c4\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c5\u000b\u0010\u0006R\u001e\u0010\u00c6\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c7\u000b\u0010\u0006R\u001e\u0010\u00c8\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c9\u000b\u0010\u0006R\u001e\u0010\u00ca\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00cb\u000b\u0010\u0006R\u001e\u0010\u00cc\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00cd\u000b\u0010\u0006R\u001e\u0010\u00ce\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00cf\u000b\u0010\u0006R\u001e\u0010\u00d0\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d1\u000b\u0010\u0006R\u001e\u0010\u00d2\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d3\u000b\u0010\u0006R\u001e\u0010\u00d4\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d5\u000b\u0010\u0006R\u001e\u0010\u00d6\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d7\u000b\u0010\u0006R\u001e\u0010\u00d8\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d9\u000b\u0010\u0006R\u001e\u0010\u00da\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00db\u000b\u0010\u0006R\u001e\u0010\u00dc\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00dd\u000b\u0010\u0006R\u001e\u0010\u00de\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00df\u000b\u0010\u0006R\u001e\u0010\u00e0\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e1\u000b\u0010\u0006R\u001e\u0010\u00e2\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e3\u000b\u0010\u0006R\u001e\u0010\u00e4\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e5\u000b\u0010\u0006R\u001e\u0010\u00e6\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e7\u000b\u0010\u0006R\u001e\u0010\u00e8\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e9\u000b\u0010\u0006R\u001e\u0010\u00ea\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00eb\u000b\u0010\u0006R\u001e\u0010\u00ec\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00ed\u000b\u0010\u0006R\u001e\u0010\u00ee\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00ef\u000b\u0010\u0006R\u001e\u0010\u00f0\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00f1\u000b\u0010\u0006R\u001e\u0010\u00f2\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00f3\u000b\u0010\u0006R\u001e\u0010\u00f4\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00f5\u000b\u0010\u0006R\u001e\u0010\u00f6\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00f7\u000b\u0010\u0006R\u001e\u0010\u00f8\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00f9\u000b\u0010\u0006R\u001e\u0010\u00fa\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00fb\u000b\u0010\u0006R\u001e\u0010\u00fc\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00fd\u000b\u0010\u0006R\u001e\u0010\u00fe\u000b\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00ff\u000b\u0010\u0006R\u001e\u0010\u0080\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0081\u000c\u0010\u0006R\u001e\u0010\u0082\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0083\u000c\u0010\u0006R\u001e\u0010\u0084\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0085\u000c\u0010\u0006R\u001e\u0010\u0086\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0087\u000c\u0010\u0006R\u001e\u0010\u0088\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0089\u000c\u0010\u0006R\u001e\u0010\u008a\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u008b\u000c\u0010\u0006R\u001e\u0010\u008c\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u008d\u000c\u0010\u0006R\u001e\u0010\u008e\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u008f\u000c\u0010\u0006R\u001e\u0010\u0090\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0091\u000c\u0010\u0006R\u001e\u0010\u0092\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0093\u000c\u0010\u0006R\u001e\u0010\u0094\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0095\u000c\u0010\u0006R\u001e\u0010\u0096\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0097\u000c\u0010\u0006R\u001e\u0010\u0098\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0099\u000c\u0010\u0006R\u001e\u0010\u009a\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u009b\u000c\u0010\u0006R\u001e\u0010\u009c\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u009d\u000c\u0010\u0006R\u001e\u0010\u009e\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u009f\u000c\u0010\u0006R\u001e\u0010\u00a0\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a1\u000c\u0010\u0006R\u001e\u0010\u00a2\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a3\u000c\u0010\u0006R\u001e\u0010\u00a4\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a5\u000c\u0010\u0006R\u001e\u0010\u00a6\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a7\u000c\u0010\u0006R\u001e\u0010\u00a8\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00a9\u000c\u0010\u0006R\u001e\u0010\u00aa\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00ab\u000c\u0010\u0006R\u001e\u0010\u00ac\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00ad\u000c\u0010\u0006R\u001e\u0010\u00ae\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00af\u000c\u0010\u0006R\u001e\u0010\u00b0\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00b1\u000c\u0010\u0006R\u001e\u0010\u00b2\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00b3\u000c\u0010\u0006R\u001e\u0010\u00b4\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00b5\u000c\u0010\u0006R\u001e\u0010\u00b6\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00b7\u000c\u0010\u0006R\u001e\u0010\u00b8\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00b9\u000c\u0010\u0006R\u001e\u0010\u00ba\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00bb\u000c\u0010\u0006R\u001e\u0010\u00bc\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00bd\u000c\u0010\u0006R\u001e\u0010\u00be\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00bf\u000c\u0010\u0006R\u001e\u0010\u00c0\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c1\u000c\u0010\u0006R\u001e\u0010\u00c2\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c3\u000c\u0010\u0006R\u001e\u0010\u00c4\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c5\u000c\u0010\u0006R\u001e\u0010\u00c6\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c7\u000c\u0010\u0006R\u001e\u0010\u00c8\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00c9\u000c\u0010\u0006R\u001e\u0010\u00ca\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00cb\u000c\u0010\u0006R\u001e\u0010\u00cc\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00cd\u000c\u0010\u0006R\u001e\u0010\u00ce\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00cf\u000c\u0010\u0006R\u001e\u0010\u00d0\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d1\u000c\u0010\u0006R\u001e\u0010\u00d2\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d3\u000c\u0010\u0006R\u001e\u0010\u00d4\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d5\u000c\u0010\u0006R\u001e\u0010\u00d6\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d7\u000c\u0010\u0006R\u001e\u0010\u00d8\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00d9\u000c\u0010\u0006R\u001e\u0010\u00da\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00db\u000c\u0010\u0006R\u001e\u0010\u00dc\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00dd\u000c\u0010\u0006R\u001e\u0010\u00de\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00df\u000c\u0010\u0006R\u001e\u0010\u00e0\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e1\u000c\u0010\u0006R\u001e\u0010\u00e2\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e3\u000c\u0010\u0006R\u001e\u0010\u00e4\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e5\u000c\u0010\u0006R\u001e\u0010\u00e6\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e7\u000c\u0010\u0006R\u001e\u0010\u00e8\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00e9\u000c\u0010\u0006R\u001e\u0010\u00ea\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00eb\u000c\u0010\u0006R\u001e\u0010\u00ec\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00ed\u000c\u0010\u0006R\u001e\u0010\u00ee\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00ef\u000c\u0010\u0006R\u001e\u0010\u00f0\u000c\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u