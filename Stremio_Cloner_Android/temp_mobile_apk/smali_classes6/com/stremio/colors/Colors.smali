06\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00f3\u0012\u0010\u0006R\u001e\u0010\u00f4\u0012\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00f5\u0012\u0010\u0006R\u001e\u0010\u00f6\u0012\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00f7\u0012\u0010\u0006R\u001e\u0010\u00f8\u0012\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00f9\u0012\u0010\u0006R\u001e\u0010\u00fa\u0012\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00fb\u0012\u0010\u0006R\u001e\u0010\u00fc\u0012\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00fd\u0012\u0010\u0006R\u001e\u0010\u00fe\u0012\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u00ff\u0012\u0010\u0006R\u001e\u0010\u0080\u0013\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0081\u0013\u0010\u0006R\u001e\u0010\u0082\u0013\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0083\u0013\u0010\u0006R\u001e\u0010\u0084\u0013\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0085\u0013\u0010\u0006R\u001e\u0010\u0086\u0013\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u0008\u0087\u0013\u0010\u0006R\u001e\u0010\u0088\u0013\u001a\u00020\u0004\u00f8\u0001\u0000\u00f8\u0001\u0001\u00f8\u0001\u0002\u00a2\u0006\u000b\n\u0002\u0010\u0007\u001a\u0005\u