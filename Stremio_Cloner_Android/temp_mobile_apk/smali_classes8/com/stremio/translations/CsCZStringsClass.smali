0d7\u0007\u0010\u0007R\u0016\u0010\u00d8\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00d9\u0007\u0010\u0007R\u0016\u0010\u00da\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00db\u0007\u0010\u0007R\u0016\u0010\u00dc\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00dd\u0007\u0010\u0007R\u0016\u0010\u00de\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00df\u0007\u0010\u0007R\u0016\u0010\u00e0\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00e1\u0007\u0010\u0007R\u0016\u0010\u00e2\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00e3\u0007\u0010\u0007R\u0016\u0010\u00e4\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00e5\u0007\u0010\u0007R\u0016\u0010\u00e6\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00e7\u0007\u0010\u0007R\u0016\u0010\u00e8\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00e9\u0007\u0010\u0007R\u0016\u0010\u00ea\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00eb\u0007\u0010\u0007R\u0016\u0010\u00ec\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00ed\u0007\u0010\u0007R\u0016\u0010\u00ee\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00ef\u0007\u0010\u0007R\u0016\u0010\u00f0\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00f1\u0007\u0010\u0007R\u0016\u0010\u00f2\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00f3\u0007\u0010\u0007R\u0016\u0010\u00f4\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00f5\u0007\u0010\u0007R\u0016\u0010\u00f6\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00f7\u0007\u0010\u0007R\u0016\u0010\u00f8\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00f9\u0007\u0010\u0007R\u0016\u0010\u00fa\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00fb\u0007\u0010\u0007R\u0016\u0010\u00fc\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00fd\u0007\u0010\u0007R\u0016\u0010\u00fe\u0007\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00ff\u0007\u0010\u0007R\u0016\u0010\u0080\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0081\u0008\u0010\u0007R\u0016\u0010\u0082\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0083\u0008\u0010\u0007R\u0016\u0010\u0084\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0085\u0008\u0010\u0007R\u0016\u0010\u0086\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0087\u0008\u0010\u0007R\u0016\u0010\u0088\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0089\u0008\u0010\u0007R\u0016\u0010\u008a\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u008b\u0008\u0010\u0007R\u0016\u0010\u008c\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u008d\u0008\u0010\u0007R\u0016\u0010\u008e\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u008f\u0008\u0010\u0007R\u0016\u0010\u0090\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0091\u0008\u0010\u0007R\u0016\u0010\u0092\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0093\u0008\u0010\u0007R\u0016\u0010\u0094\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0095\u0008\u0010\u0007R\u0016\u0010\u0096\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0097\u0008\u0010\u0007R\u0016\u0010\u0098\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u0099\u0008\u0010\u0007R\u0016\u0010\u009a\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u009b\u0008\u0010\u0007R\u0016\u0010\u009c\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u009d\u0008\u0010\u0007R\u0016\u0010\u009e\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u009f\u0008\u0010\u0007R\u0016\u0010\u00a0\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00a1\u0008\u0010\u0007R\u0016\u0010\u00a2\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00a3\u0008\u0010\u0007R\u0016\u0010\u00a4\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00a5\u0008\u0010\u0007R\u0016\u0010\u00a6\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00a7\u0008\u0010\u0007R\u0016\u0010\u00a8\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00a9\u0008\u0010\u0007R\u0016\u0010\u00aa\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00ab\u0008\u0010\u0007R\u0016\u0010\u00ac\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00ad\u0008\u0010\u0007R\u0016\u0010\u00ae\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00af\u0008\u0010\u0007R\u0016\u0010\u00b0\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00b1\u0008\u0010\u0007R\u0016\u0010\u00b2\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00b3\u0008\u0010\u0007R\u0016\u0010\u00b4\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00b5\u0008\u0010\u0007R\u0016\u0010\u00b6\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00b7\u0008\u0010\u0007R\u0016\u0010\u00b8\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00b9\u0008\u0010\u0007R\u0016\u0010\u00ba\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00bb\u0008\u0010\u0007R\u0016\u0010\u00bc\u0008\u001a\u00020\u0005X\u0096D\u00a2\u0006\t\n\u0000\u001a\u0005\u0008\u00bd\u0008\u0010\u0007R\u0016\u0010\u00be\u0008\u001a\u00020\u0005X\u0096D\u00a2\u000